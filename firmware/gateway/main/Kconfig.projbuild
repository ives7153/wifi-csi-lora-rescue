menu "EchoGuard Gateway Configuration"

    config ECHOGUARD_GATEWAY_SSID
        string "Gateway SoftAP SSID"
        default "EchoGuard-GW-01"
        help
            WPA2-PSK SoftAP name used by this Gateway build. Keep GW-01 as
            the default and override it in a local sdkconfig for GW-02.

    config ECHOGUARD_GATEWAY_ID
        string "Gateway identity reported to the upper computer"
        default "GW-01"
        help
            Stable identity included in gateway_status JSON frames.

    config ECHOGUARD_WIFI_PASSWORD
        string "Gateway SoftAP WPA2 password"
        default "511511511"
        help
            WPA2 password shared with Rescue Nodes. The value is never printed
            to the runtime log.

    config ECHOGUARD_OTA_ENABLED
        bool "Enable Gateway LAN OTA service"
        default n
        help
            Enable the authenticated HTTP OTA service for this Gateway build.
            Keep this disabled for Nodes and Gateway 02.

    config ECHOGUARD_OTA_TOKEN
        string "Gateway LAN OTA token"
        depends on ECHOGUARD_OTA_ENABLED
        default ""
        help
            Local authentication token required by the OTA upload endpoint.
            Set a value of at least 16 characters in an ignored local sdkconfig;
            never commit the token to Git.

endmenu
