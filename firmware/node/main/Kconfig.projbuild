menu "Rescue Node Configuration"

    config RESCUE_NODE_ID
        int "Rescue node ID"
        range 1 255
        default 1
        help
            Unique node ID sent in the LoRa payload and Gateway JSON frame.
            Set a different ID before flashing each physical rescue node.

    config ECHOGUARD_PRIMARY_SSID
        string "Primary Gateway SSID"
        default "EchoGuard-GW-01"

    config ECHOGUARD_SECONDARY_SSID
        string "Secondary Gateway SSID"
        default "EchoGuard-GW-02"

    config ECHOGUARD_WIFI_PASSWORD
        string "Gateway WPA2 password"
        default "511511511"
        help
            Shared password for the primary and secondary Gateway SoftAPs.

endmenu
